{
  "name": "bapell-gestor-pro",
  "version": "1.0.9",
  "description": "Bapell Gestor Pro - Sistema de Precificação Local",
  "author": "Bapell Gestor Pro",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "clean": "powershell -Command \"if (Test-Path 'dist') { Remove-Item -Recurse -Force 'dist' }\"",
    "build-clean": "npm run clean && npm run build"
  },
  "build": {
    "appId": "com.bapellgestorpro.app",
    "productName": "Bapell Gestor Pro",
    "win": {
      "target": "nsis",
      "icon": "imagens/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Bapell Gestor Pro",
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "**/*",
      "!node_modules/**",
      "!dist/**",
      "!gerador*/**",
      "!**/*.pem",
      "!**/*.key",
      "!**/*.pfx",
      "!**/*.p12",
      "!.git/**",
      "!.vscode/**",
      "!package-lock.json"
    ]
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.0.0"
  }
}
